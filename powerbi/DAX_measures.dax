// =====================================================================
// Power BI measures — Hospital Readmission Analytics (real UCI data)
// Table name in Power BI: Encounters  (from hospital_encounters_clean.csv)
// In Power Query set: a1c_tested, med_changed, expired, readmit_eligible,
// readmitted_30d -> True/False; counts and length_of_stay -> Whole number.
// =====================================================================

// ---------- Sort helper tables (Modeling > New table) ----------
AgeOrder =
DATATABLE ( "age_group", STRING, "age_sort", INTEGER,
    { { "Under 40", 1 }, { "40-49", 2 }, { "50-59", 3 }, { "60-69", 4 }, { "70-79", 5 }, { "80+", 6 } } )
// Relationship: AgeOrder[age_group] 1 -> * Encounters[age_group]; sort age_group by age_sort.

// ---------- Volume ----------
Encounters = COUNTROWS ( Encounters )

Unique Patients = DISTINCTCOUNT ( Encounters[patient_nbr] )

Emergency Share % =
DIVIDE ( CALCULATE ( [Encounters], Encounters[admission_type] = "Emergency" ), [Encounters] )

Repeat Encounters = [Encounters] - [Unique Patients]

// ---------- Length of stay ----------
Avg LOS = AVERAGE ( Encounters[length_of_stay] )

Median LOS = MEDIAN ( Encounters[length_of_stay] )

Bed Days = SUM ( Encounters[length_of_stay] )

Bed Day Share % = DIVIDE ( [Bed Days], CALCULATE ( [Bed Days], ALL ( Encounters ) ) )

Avg LOS vs Network =
[Avg LOS] - CALCULATE ( [Avg LOS], REMOVEFILTERS ( Encounters[diag_group], Encounters[age_group] ) )

// ---------- Readmissions ----------
Eligible Encounters = CALCULATE ( [Encounters], Encounters[readmit_eligible] = TRUE () )

Readmissions 30d = CALCULATE ( [Encounters], Encounters[readmitted_30d] = TRUE () )

Readmission Rate % = DIVIDE ( [Readmissions 30d], [Eligible Encounters] )

Readmission Rate vs Network =
[Readmission Rate %]
    - CALCULATE ( [Readmission Rate %], REMOVEFILTERS ( Encounters[diag_group], Encounters[age_group], Encounters[discharge_group], Encounters[prior_inpatient_band] ) )

Readmission Flag Colour =
VAR net = CALCULATE ( [Readmission Rate %], ALL ( Encounters ) )
RETURN IF ( [Readmission Rate %] >= net * 1.4, "#C8553D", "#2A6F97" )

// ---------- Clinical process ----------
HbA1c Tested % = DIVIDE ( CALCULATE ( [Encounters], Encounters[a1c_tested] = TRUE () ), [Encounters] )

Avg Medications = AVERAGE ( Encounters[num_medications] )

Avg Lab Tests = AVERAGE ( Encounters[num_lab_procedures] )

Mortality % = DIVIDE ( CALCULATE ( [Encounters], Encounters[expired] = TRUE () ), [Encounters] )

// ---------- Dynamic title ----------
Selection Title =
"Showing " & FORMAT ( [Encounters], "#,0" ) & " encounters"
    & IF ( ISFILTERED ( Encounters[age_group] ), " · ages " & CONCATENATEX ( VALUES ( Encounters[age_group] ), Encounters[age_group], ", " ), "" )
