// =====================================================================
// Power BI measures — Hospital Analytics
// Table name in Power BI: Admissions   (from hospital_admissions_clean.csv)
// In Power Query set types: readmitted_30d, readmit_eligible, high_cost,
// age_imputed, cost_corrected -> True/False; dates -> Date; costs -> Decimal.
// Create a display folder per section (Model view > Properties > Display folder).
// =====================================================================

// ---------- Date table (Modeling > New table) ----------
Calendar =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2024, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Month No", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM" ),
    "Year-Month", FORMAT ( [Date], "YYYY-MM" ),
    "Weekday", FORMAT ( [Date], "dddd" ),
    "Weekday No", WEEKDAY ( [Date], 2 )
)
// Relationship: Calendar[Date] 1 -> * Admissions[admission_date]
// Sort Calendar[Month] by [Month No] and [Weekday] by [Weekday No].

// ---------- Volume ----------
Admissions = COUNTROWS ( Admissions )

Unique Patients = DISTINCTCOUNT ( Admissions[patient_id] )

Emergency Share % =
DIVIDE (
    CALCULATE ( [Admissions], Admissions[admission_type] = "Emergency" ),
    [Admissions]
)

Admissions PY =
CALCULATE ( [Admissions], SAMEPERIODLASTYEAR ( Calendar[Date] ) )

Admissions YoY % = DIVIDE ( [Admissions] - [Admissions PY], [Admissions PY] )

// ---------- Length of stay ----------
Avg LOS = AVERAGE ( Admissions[length_of_stay] )

Median LOS = MEDIAN ( Admissions[length_of_stay] )

Total Bed Days = SUM ( Admissions[length_of_stay] )

Avg LOS vs Hospital =
[Avg LOS] - CALCULATE ( [Avg LOS], REMOVEFILTERS ( Admissions[primary_diagnosis], Admissions[age_group], Admissions[department] ) )

// ---------- Readmissions ----------
Eligible Stays =
CALCULATE ( [Admissions], Admissions[readmit_eligible] = TRUE () )

Readmissions =
CALCULATE ( [Admissions], Admissions[readmitted_30d] = TRUE () )

Readmission Rate % = DIVIDE ( [Readmissions], [Eligible Stays] )

Readmission Rate vs Hospital =
[Readmission Rate %]
    - CALCULATE ( [Readmission Rate %], REMOVEFILTERS ( Admissions[primary_diagnosis], Admissions[age_group], Admissions[department] ) )

// Conditional-format helper: red if group is 1.5x the hospital rate
Readmission Flag Colour =
VAR hosp = CALCULATE ( [Readmission Rate %], ALL ( Admissions ) )
RETURN IF ( [Readmission Rate %] >= hosp * 1.5, "#C8553D", "#2A6F97" )

// ---------- Cost ----------
Total Cost = SUM ( Admissions[total_cost] )

Total Cost (Cr) = DIVIDE ( [Total Cost], 10000000 )

Avg Cost per Stay = AVERAGE ( Admissions[total_cost] )

Avg Cost per Day = DIVIDE ( [Total Cost], SUMX ( Admissions, MAX ( Admissions[length_of_stay], 1 ) ) )

Cost Share % = DIVIDE ( [Total Cost], CALCULATE ( [Total Cost], ALL ( Admissions ) ) )

High-Cost Stays = CALCULATE ( [Admissions], Admissions[high_cost] = TRUE () )

High-Cost Share of Spend % =
DIVIDE ( CALCULATE ( [Total Cost], Admissions[high_cost] = TRUE () ), [Total Cost] )

// ---------- Outcomes ----------
Mortality % =
DIVIDE ( CALCULATE ( [Admissions], Admissions[discharge_disposition] = "Expired" ), [Admissions] )

ICU Stay % = DIVIDE ( CALCULATE ( [Admissions], Admissions[icu_days] > 0 ), [Admissions] )

// ---------- Dynamic title ----------
Selection Title =
"Showing " & FORMAT ( [Admissions], "#,0" ) & " admissions"
    & IF ( ISFILTERED ( Admissions[department] ), " · " & CONCATENATEX ( VALUES ( Admissions[department] ), Admissions[department], ", " ), "" )
